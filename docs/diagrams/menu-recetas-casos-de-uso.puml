@startuml menu-recetas-casos-de-uso
left to right direction
skinparam packageStyle rect
skinparam usecase {
  BackgroundColor #F4F1FF
  BorderColor #6C5CE7
}
skinparam actorStyle awesome

actor "Administrador" as Admin

rectangle "Módulo de Menú / Recetas" {
  usecase "Ver catálogo de productos" as UC1
  usecase "Editar producto\n(nombre, categoría, precio,\nestado, descripción)" as UC2
  usecase "Ver lista de productos\ncon receta" as UC3
  usecase "Editar receta (BOM)" as UC4
  usecase "Ver costo teórico\n(BOM x costo insumo)" as UC5
  usecase "Editar extras\n(modificadores)" as UC6
}

Admin --> UC1
Admin --> UC3

UC2 .> UC1 : <<extend>>
UC4 .> UC3 : <<extend>>
UC6 .> UC3 : <<extend>>
UC4 .> UC5 : <<include>>

note bottom of UC1
  "Registrar nuevo item" (tipo vendible),
  en el módulo de Inventario, crea
  automáticamente el Producto
  correspondiente aquí.
end note

@enduml
